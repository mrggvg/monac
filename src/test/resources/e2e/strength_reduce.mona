// expect: A=115
// Both operand orders must give the same answer, whichever way strength
// reduction rewrote them.
//
//   8 * 5      = 40   (constant on the left)
//   5 * 8      = 40   (constant on the right)
//   80 / 4     = 20
//   77 % 8     = 5
//   8 / 5      = 1    non-commutative, must not be reordered
//   8 - 5      = 3    non-commutative
//   40+40+20+5+1+3 = 109 ... plus 6 below
word times(word x) { return 8 * x; }
word timesOther(word x) { return x * 8; }
word divide(word x) { return x / 4; }
word remainder(word x) { return x % 8; }
word divideInto(word x) { return 8 / x; }
word subtractFrom(word x) { return 8 - x; }

word main() {
    word total = 0;
    total += times(5);          // 40
    total += timesOther(5);     // 40
    total += divide(80);        // 20
    total += remainder(77);     // 5
    total += divideInto(5);     // 1
    total += subtractFrom(5);   // 3
    total += 6;                 // 115
    return total;
}
