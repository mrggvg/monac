// expect: A=1
// Requires declaring every top-level name before analysing any body, or the
// call to isOdd from isEven would be undeclared.
word isEven(word n) {
    if (n == 0) return 1;
    return isOdd(n - 1);
}

word isOdd(word n) {
    if (n == 0) return 0;
    return isEven(n - 1);
}

word main() {
    return isEven(10);
}
