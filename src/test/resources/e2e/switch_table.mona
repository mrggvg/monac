// expect: A=103
// Five dense labels, so this must compile to a jump table rather than a chain
// of comparisons.
word classify(word n) {
    switch (n) {
        case 0: return 100;
        case 1: return 101;
        case 2: return 102;
        case 3: return 103;
        case 4: return 104;
        default: return 999;
    }
}

word main() { return classify(3); }
