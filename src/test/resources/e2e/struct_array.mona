// expect: A=120
// An array of structs. Subscripting already scales by the element size, and a
// struct's size is just the sum of its members, so grid[i].y needs no new
// machinery — the index is scaled by four and the member adds two.
struct Cell {
    word value;
    word weight;
};

struct Cell grid[5];

word main() {
    word i = 0;
    while (i < 5) {
        grid[i].value = i * 3;
        grid[i].weight = i + 1;
        i = i + 1;
    }

    word total = 0;
    i = 0;
    while (i < 5) {
        total = total + grid[i].value * grid[i].weight;
        i = i + 1;
    }
    // 0*1 + 3*2 + 6*3 + 9*4 + 12*5 = 0 + 6 + 18 + 36 + 60
    return total;
}
