// expect: A=0
//
// (type)expr. Returns 0 when every claim holds, otherwise the failing check.

struct Point {
    word x;
    word y;
};

word main() {
    // A cast to a byte type narrows, which retires `& 255` as the idiom.
    word big = 0x1234;
    if ((byte) big != 0x34) return 1;
    if ((word) (byte) big != 0x34) return 2;

    // Narrow then widen: an sbyte sign-extends, a byte does not.
    word n = 200;
    if ((byte) n != 200) return 3;
    if ((word) (sbyte) n != 0xFFC8) return 4;

    // Signedness of the cast decides the comparison.
    sword s = (sbyte) 200;
    if (s >= 0) return 5;
    if ((word) s != 0xFFC8) return 6;

    // A pointer cast reinterprets without moving anything.
    word v = 0x0102;
    byte* b = (byte*) &v;
    // The machine is big-endian, so the high byte comes first.
    if (b[0] != 1) return 7;
    if (b[1] != 2) return 8;

    struct Point p;
    p.x = 7;
    p.y = 9;
    word* w = (word*) &p;
    if (w[0] != 7) return 9;
    if (w[1] != 9) return 10;

    // A cast binds tighter than a binary operator.
    if ((byte) 0x1FF + 1 != 256) return 11;

    // Casting an already-wide value changes nothing.
    if ((word) 0xFFFF != 0xFFFF) return 12;
    return 0;
}
