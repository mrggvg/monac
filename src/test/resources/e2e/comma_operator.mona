// expect: A=0
//
// The comma operator. Returns 0 when every claim holds, otherwise the failing check.

word log = 0;

word note(word bit) {
    log = log | bit;
    return bit;
}

word two(word a, word b) {
    return a * 100 + b;
}

word main() {
    // The value is the right operand; the left runs only for its effects.
    word r = (1, 2);
    if (r != 2) return 1;

    // Left to right.
    log = 0;
    r = (note(1), note(2), note(4));
    if (r != 4) return 2;
    if (log != 7) return 3;

    // It binds looser than assignment, so `a = 1, 2` assigns 1.
    word a = 0;
    a = 1, 2;
    if (a != 1) return 4;

    // Parenthesised, the whole comma expression is the value assigned.
    word b = 0;
    b = (1, 2);
    if (b != 2) return 5;

    // A comma between arguments is a separator, never the operator.
    if (two(1, 2) != 102) return 6;
    // Which is why passing a comma expression needs parentheses.
    if (two((1, 3), 4) != 304) return 7;

    // Its home is a for loop with two counters.
    word i = 0;
    word j = 10;
    word met = 0;
    for (i = 0, j = 10; i < j; i++, j--) met = met + 1;
    if (met != 5) return 8;
    if (i != 5) return 9;
    if (j != 5) return 10;

    // As an expression statement.
    log = 0;
    note(8), note(16);
    if (log != 24) return 11;

    // In the arms of a conditional, and in a while test.
    word n = (0 ? (note(32), 1) : (2, 3));
    if (n != 3) return 12;

    word k = 0;
    word steps = 0;
    while (steps = steps + 1, k < 4) k = k + 2;
    if (k != 4) return 13;
    if (steps != 3) return 14;

    // In a subscript, where the comma is the operator because [] is not a list.
    word v[3];
    v[0] = 5;
    v[1] = 6;
    v[2] = 7;
    if (v[(0, 2)] != 7) return 15;
    return 0;
}
